bin/
build/
out/
target/

# Archivos de empaquetado
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# ==========================================
# Configuración y Archivos de IntelliJ IDEA
# ==========================================
.idea/
*.iml
*.iws
*.ipr
out/

# Si trabajas en equipo, a veces se comparte .idea/codeStyles o .idea/icon.png,
# pero ignorar toda la carpeta .idea/ es lo ideal para evitar conflictos.

